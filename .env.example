# Copy this file to .env.local and change what you need. Every line is optional.

# --- Story writer ---
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_HOST=http://127.0.0.1:11434
# Paste a Claude API key here to let Claude write stories (optional, paid).
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# Force a writer or style no matter what the app says: ollama | claude | demo, hook | cozy
REELHOUSE_ENGINE=
REELHOUSE_STYLE=

# --- Voices and music (set to 0 to turn off) ---
REELHOUSE_VOICE=1
REELHOUSE_MUSIC=1
PIPER_NARRATOR_VOICE=en_US-lessac-medium
PIPER_CHARACTER_VOICE=en_US-libritts_r-medium

# --- Where videos go ---
REELHOUSE_OUTPUT_DIR=./output

# --- Trends ---
REELHOUSE_SUBREDDITS=aivideo,animation,WritingPrompts,shortstories
REELHOUSE_TRENDS_RSS=https://trends.google.com/trending/rss?geo=US

# --- Password login (turn on for servers) ---
REELHOUSE_PASSWORD=
REELHOUSE_USER=reelhouse

# --- Rendering: only if Remotion can't find a browser by itself ---
REMOTION_BROWSER=

# --- TikTok posting (optional, see TIKTOK.md) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# TIKTOK_REDIRECT_URI=https://your-address/api/tiktok/callback

# --- YouTube Shorts uploads (optional, see YOUTUBE.md) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REDIRECT_URI=http://localhost:3000/api/youtube/callback
# Optional: lets the Niche Scout also search YouTube for top Shorts on your keywords (free API key, see YOUTUBE.md)
YOUTUBE_API_KEY=
